node_modules/
.output/
.turbo/
dist/
*.local
.env
.env.local
.env.*.local

# VAPID key material (Phase 2, push notifications) and any other local-only
# secret scratch files — never committed, generated fresh per machine/session.
.secrets/

# TanStack Router — auto-generated, regenerated on every dev start
apps/*/app/routeTree.gen.ts

# TanStack Start transpiled config artifacts
apps/*/app.config.timestamp_*.js

# TanStack Start local dev state
.tanstack/

# Wrangler local dev state
.wrangler/

CLAUDE.local.md

# Heavy image originals — optimized variants in apps/web/public/images/ are committed
apps/*/images-source/

# Uploaded-set artwork variants — regenerated on every build by
# scripts/optimize-images.ts from each set's R2 artworkOriginalUrl. A
# SEPARATE directory from public/images/sets/ (legacy sets' committed
# variants) deliberately: a path-based ignore can't tell an uploaded set's
# `{id}-640.avif` apart from a legacy one's `002-640.avif` in the same
# folder — they're the same shape of file. See optimize-images.ts's own
# comment on UPLOADED_OUT for the full reasoning.
apps/*/public/images/uploads/

# Per-route OG banners — regenerated on every build by scripts/generate-og.ts
apps/*/public/og/

# Sitemap — regenerated on every build by scripts/generate-sitemap.ts
apps/*/public/sitemap.xml

# Playwright artefacts — reports, traces, videos
apps/*/playwright-report/
apps/*/test-results/

# Vitest coverage
apps/*/coverage/

# Storybook static build — regenerated by `build-storybook`, what CI's
# Chromatic job builds fresh each run
packages/*/storybook-static/

# Cloudflare Access AUD tag — a public application identifier, not a credential.
# It says which Access app a JWT was issued for; forging a token still requires
# Cloudflare's private signing key. verifyAccessJwt.ts reads it to know what to
# verify against. See apps/admin/wrangler.toml's own comment.
da73131d64555b38abb8de17ed09f6c44e33106b:apps/admin/wrangler.toml:generic-api-key:21