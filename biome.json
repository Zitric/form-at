{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all"
    }
  },
  "css": {
    "formatter": {
      "enabled": true
    }
  },
  "files": {
    "ignore": [
      "**/node_modules/**",
      "**/.output/**",
      "**/.turbo/**",
      "**/dist/**",
      "**/routeTree.gen.ts",
      "**/playwright-report/**",
      "**/test-results/**",
      "**/coverage/**"
    ]
  }
}
