# Cloudflare Pages header rules — STATIC ASSETS ONLY. Pages applies this
# file to responses served from the asset layer; responses generated by
# _worker.js Functions (all SSR documents) do NOT get these headers — the
# document CSP therefore lives in app/server.ts (keep the two CSP strings
# in sync; server.ts is the source of truth).
#
# M3 (2026-07-02 review): immutable caching for hashed assets, explicit
# no-cache for the service worker script.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Browsers already cap SW script freshness at 24h; explicit no-cache is
# belt-and-braces so an update NEVER waits on HTTP caching.
/sw.js
  Cache-Control: no-cache

# CSP for static documents (offline.html is the only one). SSR documents
# get the same policy from app/server.ts. AUDIO HOST: the R2 dev URL below
# is swept to the custom domain by TECH_DEBT 19 — this line is deliberately
# greppable by hostname.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self' https://pub-e15e86da649d4c91b6666141bfe67664.r2.dev; connect-src 'self' https://pub-e15e86da649d4c91b6666141bfe67664.r2.dev; worker-src 'self'; manifest-src 'self'; base-uri 'self'; frame-ancestors 'self'
