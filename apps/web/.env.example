# Copy to `.env` (git-ignored) and fill in real values. Required by
# `scripts/send-push.ts` — see PWA_PROGRESS.md's Phase 2 section for the
# full setup walkthrough ("How to send an announcement today").

# The VAPID private key, JWK format, as printed by `npx @pushforge/builder
# vapid`. Generate ONE key pair (not one per environment) — the public half
# goes in `app/utils/vapidPublicKey.ts` (committed, safe to expose) and the
# private half goes here AND as the `VAPID_PRIVATE_KEY_JWK` Cloudflare
# Pages secret (`npx wrangler pages secret put VAPID_PRIVATE_KEY_JWK
# --project-name=form-at-web`).
VAPID_PRIVATE_KEY_JWK={"alg":"ES256","kty":"EC","crv":"P-256","x":"...","y":"...","d":"..."}

# VAPID "sub" claim (RFC 8292) — a contact the push service can reach if
# something's wrong with your sends. mailto: or https: URL.
VAPID_CONTACT_EMAIL=mailto:format.gla@gmail.com
